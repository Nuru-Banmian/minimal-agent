# Copy to .env and fill in your own regional endpoint and key.
LLM_MODEL=qwen-plus
LLM_BASE_URL=
DASHSCOPE_API_KEY=
LLM_TIMEOUT_SECONDS=30

# tavily enables web search; mock keeps the offline teaching fixture.
SEARCH_PROVIDER=mock
TAVILY_API_KEY=

# Context uses approximate UTF-8 byte budgets, NOT exact token counts.
MEMORY_CONTEXT_BYTES=64000
MEMORY_OUTPUT_TOKENS=1024
MEMORY_KEEP_RECENT_TURNS=2
MEMORY_SUMMARY_BYTES=4096
MEMORY_SUMMARY_INPUT_BYTES=256000
MEMORY_SUMMARY_TIMEOUT_SECONDS=15
MEMORY_TOOL_RESULT_BYTES=8000
